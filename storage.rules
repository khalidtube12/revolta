rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── ملفات التحدي: قراءة عامة، كتابة للمسجّلين فقط ──
    match /challenge/{file} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // ── باقي الملفات: محظورة ──
    match /{allPaths=**} {
      allow read, write: if false;
    }

  }
}
